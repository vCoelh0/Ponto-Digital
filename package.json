{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <25"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:deploy": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/ponto-digital build",
    "start:deploy": "node artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
